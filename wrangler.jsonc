// Nox online on Cloudflare Pages (free plan): nox-play.pages.dev
// public/ is the website (pages and downloads); functions/ runs /api/... (worker.mjs).
{
  "name": "nox-play",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // where usernames, games, reports, bans and bug reports are kept
  // (the secrets ADMIN_USER, ADMIN_PASS, ADMIN_EMAIL, RESEND_API_KEY are set on Cloudflare, not here)
  "d1_databases": [
    { "binding": "DB", "database_name": "nox", "database_id": "6642ab25-13c8-42db-936a-3a35d1fc1a18" }
  ]
}
